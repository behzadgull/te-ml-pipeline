# Data
data/
*.csv
*.parquet
*.pkl

# Credentials / secrets
.env
*.key
credentials.json
secrets.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Models / outputs
models/
*.ipynb_checkpoints/
checkpoints/*
logs/

# Confirmed chemistry-cluster ladder checkpoints + their frozen
# hyperparameters, cited as provenance throughout CLAUDE.md -- tracked
# despite the blanket checkpoints/ ignore above. Everything else under
# checkpoints/ (including checkpoints/saved_predictions/te-ml-pipeline/data/,
# the 1.1 GB nested raw/processed data tree) stays ignored: git cannot
# re-include a file whose parent directory is excluded by a bare "dir/"
# pattern, so each ancestor level must be negated explicitly down to the
# four target directories, and nothing else is negated.
!checkpoints/saved_predictions/
checkpoints/saved_predictions/*
!checkpoints/saved_predictions/checkpoints/
checkpoints/saved_predictions/checkpoints/*
!checkpoints/saved_predictions/checkpoints/S_chemistry/
!checkpoints/saved_predictions/checkpoints/sigma_chemistry/
!checkpoints/saved_predictions/checkpoints/kappa_chemistry/
!checkpoints/saved_predictions/checkpoints/zT_chemistry/
!checkpoints/saved_predictions/checkpoints/frozen_hyperparams/

# Direct-vs-derived zT regeneration checkpoints (per-fold predictions,
# regenerated against both grouping fixes, the snapfix CSV, and the
# canonical zT frozen hyperparameters) -- tracked despite the blanket
# checkpoints/ ignore above, same rationale as the ladder checkpoints.
!checkpoints/direct_vs_derived_zt_snapfix_canonical/

# Raw Kaggle output staging copy. Every file is either byte-identical to a
# tracked file (results/, checkpoints/saved_predictions/checkpoints/) or
# archived off-machine: results/archive_manifests/kaggle_out_unmatched.sha256
# (per-file SHA256) and results/regen_postfix/20260916T161906/README.md
# (tar SHA256 and location). 430 MB, mostly .npz.
kaggle_out/

# rendered manuscript (pandoc output, regenerated from paper/paper.md)
paper/build/

# superseded run (File B hyperparameter cache); documented in CLAUDE.md; kept locally only
results/direct_vs_derived_snapfix/20260918T103933/
